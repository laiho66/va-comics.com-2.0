# VA COMICS: headere de securitate (Cloudflare le citește singur din rădăcina site-ului, ca pe _redirects).
# Nu se aplică pe Live Server (local) și nici pe /api/* (acelea vin din Workerii board și reader).
#
# PARTEA 1 (activă): reguli sigure, nu blochează nicio încărcare de imagini, scripturi sau video.
#   nosniff            browserul nu "ghicește" tipul fișierelor
#   Referrer-Policy    alte site-uri văd doar va-comics.com, nu adresa completă a paginii
#   X-Frame-Options    nimeni nu poate pune site-ul într-un iframe pe alt domeniu (clickjacking)
#   Permissions-Policy fără cameră, microfon, locație, plăți, USB (site-ul nu le folosește).
#                      Fullscreen și autoplay rămân libere (cititorul și YouTube au nevoie de ele).
#
# PARTEA 2 (ACTIVĂ din nov 2026, după test pe tot site-ul + Foundry + Reading Room):
#   Content-Security-Policy = lista surselor de unde site-ul are voie să încarce scripturi, imagini,
#   video etc. Orice altceva e BLOCAT, iar browserul scrie motivul în consolă (F12 > Console).
#   Dacă după o schimbare ceva nu se mai încarcă: verifici consola, adaugi sursa aici.
#   Urgență: schimbi temporar numele în Content-Security-Policy-Report-Only (doar raportează, nu blochează).
#   Web Analytics (Cloudflare) adaugă singur static.cloudflareinsights.com + cloudflareinsights.com.
#   Sursă externă nouă (alt site pentru imagini, video, scripturi)? Se adaugă aici, altfel apare în consolă.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.va-comics.com https://i.ytimg.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src 'self' https://www.youtube-nocookie.com https://challenges.cloudflare.com; media-src 'self'; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

/foundry/*
  X-Robots-Tag: noindex, nofollow
  # Foundry are CSP-ul lui: are nevoie de api.github.com (scrieri în repo) și api.anthropic.com (AI drafts, adormit).
  # Paginile publice NU mai au voie spre ele (regula /* de mai sus). Linia cu "!" scoate CSP-ul public, apoi îl punem pe cel de Foundry.
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.va-comics.com https://i.ytimg.com; font-src 'self'; connect-src 'self' https://api.github.com https://api.anthropic.com https://cloudflareinsights.com; frame-src 'self' https://www.youtube-nocookie.com https://challenges.cloudflare.com; media-src 'self'; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# PARTEA 3 (nov 2026, Lighthouse): imaginile din folderele de mai jos stau în browser 7 zile.
#   Vizitatorii care revin nu le mai descarcă (pagini mai rapide).
#   ATENȚIE: dacă ÎNLOCUIEȘTI o imagine păstrând ACELAȘI nume, unii vizitatori o pot vedea pe cea veche
#   până la 7 zile. Imaginile noi (cover14.webp etc.) nu au problema asta. Dacă trebuie înlocuită
#   o imagine existentă, dă-i un nume nou (ex. mace-v2.webp) și schimbă linkul din pagină.
#   HTML, CSS și JS NU sunt aici: rămân pe verificarea normală, ca orice schimbare să apară imediat.

/deaddrop/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/vanguard/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
